while True:
    n = int(input("Enter a number: "))

    if n  == 0:
        print("The number is zero")
    elif n < 0:
        print("The number is negative")
    else:
        print("The number is positive")

    cont = input("Do you want to enter another number? (yes/no): ")

    if cont.lower() != "yes":
        print("Exiting the program. Goodbye!")
        break